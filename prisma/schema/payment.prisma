model Payment {
  id                   String          @id @default(uuid())
  bookingId            String
  payerId              String
  provider             PaymentProvider
  status               PaymentStatus   @default(INITIATED)
  amount               Decimal         @db.Decimal(10, 2)
  refundAmount         Decimal         @default(0) @db.Decimal(10, 2)
  currency             String          @db.VarChar(3)
  idempotencyKey       String          @unique
  gatewaySessionId     String?         @unique
  gatewayTransactionId String?         @unique
  bankTransactionId    String?
  paymentMethod        String?
  failureReason        String?
  rawResponse          Json?
  paidAt               DateTime?
  refundedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payer   User    @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@index([payerId, createdAt])
  @@index([provider, status])
  @@index([gatewayTransactionId])
  @@map("payments")
}
